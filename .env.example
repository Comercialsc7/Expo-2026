# ===========================================
# CONFIGURAÇÕES DO SUPABASE
# ===========================================
#
# Para obter suas credenciais do Supabase:
# 1. Acesse: https://supabase.com/dashboard
# 2. Selecione seu projeto
# 3. Vá em Settings > API
# 4. Copie a URL e a chave anon/public
#
# IMPORTANTE: Nunca compartilhe suas credenciais reais!
# Este arquivo é apenas um modelo.

# URL do seu projeto Supabase
# Exemplo: https://seu-projeto-id.supabase.co
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Chave pública/anon do Supabase
# Esta chave é segura para uso no cliente
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===========================================
# OUTRAS CONFIGURAÇÕES (OPCIONAL)
# ===========================================

# Se você precisar de outras configurações de ambiente,
# adicione-as abaixo com o prefixo EXPO_PUBLIC_
# para que fiquem disponíveis no app

# Exemplo:
# EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_STRIPE_KEY=your_stripe_key_here

# Webhook disparado com 30s de atraso ao clicar em "Enviar Pendências" (quando online)
EXPO_PUBLIC_SYNC_WEBHOOK_URL=https://automacao.grupoamo.co/webhook-test/486f3eb1-cede-4e7a-915e-b733b269d16c
